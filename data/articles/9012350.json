{"schemaVersion":2,"article":{"reference":"9012350","article_id":"cd1:article:9012350","issue_id":"maso-1990-12","title":"파일복구를 쉽게 해주는 간단한 삭제 테크닉","byline":null,"page":350,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"파일복구를 쉽게 해주는"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"간단한 삭제 테크닉"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"컴퓨터 상에서 여러가지 작업을 하다 보면 아차하는 실수로 지워서는 안될 파일들을 지워버리는 경우가 허다하다. 그러나 도스 명령어는 실수로 지워진 파일을 복구하는 것까지 배려하지 않기 때문에 발을 동동 구르며 안타까와 해보아도 소용없는 일이다. PC Tools의 Undelete나 노턴 유틸리티 Unerase 등 파일 복구를 위한 기능을 내장한 몇몇 개의 유틸리티들을 이용하면 파일 이름을 기억해 낼 수 있는 파일은 쉽게 복구해 낼 수 있지만, 여러개의 파일을 동시에 잃어 버렸거나 사용법에 익숙하지 않은 상태라면 난감하기 마련이다."}]}]}],"excerpt":{"characters":322,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
