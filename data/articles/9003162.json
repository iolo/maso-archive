{"schemaVersion":2,"article":{"reference":"9003162","article_id":"cd1:article:9003162","issue_id":"maso-1990-03","title":"신인류 대커의 공포","byline":null,"page":162,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"하이테크 바이러스의 만연 [1]"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"해커들은 컴퓨터에 침입하는 행위에 대하여 플로피 디스크에 게임을 복사하는 정도의 생각을 가지고 있을 뿐이다. 또한 특별히 죄의식을 가지고 있지도 않고 그것이 엄청난 결과로 연결된다는 것을 전혀 생각하지 않는다. 따라서 악한이 처음부터 있는 것은 아니지만 그러한 생각과 행동이 축적된 결과가 사회악적인 일을 일으키게 된다는 것이 문제이다. 이러한 신인류, 대커의 공포에 대해 생각해 보는 시간을 갖는다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"하이테크 바이러스의 만연"}]}]}],"excerpt":{"characters":257,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
