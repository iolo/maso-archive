{"schemaVersion":2,"article":{"reference":"cd2-940621201","article_id":"cd2:article:940621201","issue_id":"cd2-9406","title":"프리마스터링 시스템 구입 가이드","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"940621201","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧6⟦field:vfld⟧.  212p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"박스기사 1"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧편집부⟦field:vfld⟧\n\nCD-R 시스템을 구입하기 전에 경험 많은 전문 프리마스터링 업체에 제품 선택에 대해 조언을 구하면, 먼저 안정적이고 성능이 뛰어난 소프트웨어를 선택하고 그런 다음 그 소프트웨어에 어울리는 CD-R 장비를 골라야 한다고 말한다. 결국 프리마스터링 과정에서 중요한 것은 하드웨어적인 특징보다는 소프트웨어의 성능인 셈이다. 그렇다면 프리마스터링용 소프트웨어를 선택할 때 고려해야 할 점은 무엇인지, 그리고 그에 따른 하드웨어를 선택할 때 어떤 관점에서 살펴야 하는지 알아 보자."}]}]}],"excerpt":{"characters":345,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
