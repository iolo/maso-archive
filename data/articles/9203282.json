{"schemaVersion":2,"article":{"reference":"9203282","article_id":"cd1:article:9203282","issue_id":"maso-1992-03","title":"포트란에서 마우스를 써보자","byline":null,"page":null,"status":"normalized","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"MS 포트란 5.0에서는 그래픽을 지원하므로 그래픽 사용자 인터페이스를 구현할 수 있다. 그런데 정작 그래픽 사용자 인터페이스의 필수품인 마우스는 그동안 C나 어셈블러의 전유물이었다. 이 글에서는 포트란으로 마우스 사용이 가능한 프로그램을 작성할 수 있도록 포트란에서의 마우스 인터페이스 기법을 소개한다."}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"92.3.  282p"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ 고종수"}]}]}],"excerpt":{"characters":190,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
