{"schemaVersion":2,"article":{"reference":"cd3-topic-0279","article_id":"cd3:article:topic-0279","issue_id":"cd3-9501","title":"지옥의 택시","byline":null,"page":null,"status":"success","disc":"cd3","nativeReference":"topic-0279","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"95년 1월호 (p.143)"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"공포의 여행"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"'뉴욕은 자가용을 타도, 대중교통을 타고 안심할 수 없는 도시야'. 버스나 지하철은 물론 택시로도 범죄 소굴 뉴욕에서는 확실한 안전을 보장받을 수 없다. 이 게임은 뉴욕의 케네디 공항에서 시작한다. 돈을 찾고 택시를 타면서 시간 여행이 시작된다. 현대 시대부터 로마 시대, 쥬라기 등의 여러 시대를 거쳐 환상의 시간 여행을 갔다 올 수 있다."}]}]}],"excerpt":{"characters":215,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
