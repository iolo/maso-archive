{"schemaVersion":2,"article":{"reference":"9307418a","article_id":"cd1:article:9307418a","issue_id":"maso-1993-07","title":"SYSTEM.INI 파일 정복","byline":null,"page":418,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"윈도우즈"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"SYSTEM.INI 파일정복"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"윈도우즈에는 두 개의 중요한 초기화 파일이 있다. 바로 SYSTEM.INI와 WIN.INI 파일로 이들 파일을 잘 요리하면 윈도우즈를 멋있게, 편리하게 사용할 수 있다. 여기에서는 윈도우즈를 실행시키는 데 필요한 디바이스와 드라이버 섹션과 밀접한 관련이 있는 SYSTEM.INI 파일의 각 섹션에 대해 알아보겠다. SYSTEM.INI 파일의 섹션을 잘 활용하면 지금보다 윈도우즈를 훨씬 효과적으로 사용할 수 있을 것이다."}]}]}],"excerpt":{"characters":257,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
