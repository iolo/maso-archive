{"schemaVersion":2,"article":{"reference":"8905188","article_id":"cd1:article:8905188","issue_id":"maso-1989-05","title":"프로그램 로더의 제작 기법","byline":null,"page":null,"status":"reference_with_gaps","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"프로그램 로더는 보조기억장치에 위치하는 프로그램을 주기억장치로 옮겨주는 역할을 한다. MS-DOS에서도 내부적으로 로더의 기능을 담당하는 부분이 있다. 특히 MS-DOS 2.0 이상의 버전에서는 로더 기능을 도스 서비스 형태로 제공함으로써 다른 응용 프로그램에서도 쉽게 로더 기능을 이용할 수 있도록 하고 있다. 이러한 도스 서비스를 EXEC 기능이라고 부른다. 여기에서는 MS-DOS의 시스템 로더인 EXEC 기능의 동작원리 및 사용방법에 대해 서령하고 그 활용방법을 제시하고자 한다."}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"89.5.  188p"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ 안철수"}]}]}],"excerpt":{"characters":292,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
