{"schemaVersion":2,"article":{"reference":"9012276","article_id":"cd1:article:9012276","issue_id":"maso-1990-12","title":"하드 디스크 관련 인터페이스들","byline":null,"page":null,"status":"normalized","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"모든 주변기기는 인터페이스를 통해 컴퓨터와 대화할 수 있다. 주변기기 가운데 특히나 중요한 부분을 차지하는 하드 디스크는 그 인터페이스 방식도 다양하다. 여러번 이름을 들어 알고 있으나 직접 인사를 나눈 적이 없는 친구를 만나듯이 하드 디스크와 관련된 여러가지 인터페이스 방식들과 친해질 수 있는 기회를 갖자."}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"90.12.  276p"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ 김학진"}]}]}],"excerpt":{"characters":194,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
