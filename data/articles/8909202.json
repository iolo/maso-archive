{"schemaVersion":2,"article":{"reference":"8909202","article_id":"cd1:article:8909202","issue_id":"maso-1989-09","title":"범선을 타봅시다","byline":null,"page":null,"status":"normalized","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"클리퍼를 이용한 프로그래밍 [1]"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"지난 4월호의  클리퍼를 이용한 메뉴설계  기사에서 여러분과 약속했던 명함관리 프로그램을 소개함으로써 이제서야 약속을 지키게 되었다. 비록 고객관리 프로그램으로 명칭이 변경되긴 했지만 그 원리는 동일하므로 공수표를 날린 것은 아니다. 이제 이 프로그램과 한글 운영체제 도구를 바탕으로 3회에 걸쳐 클리퍼에 목마른 독자 여러분을 시원하게 진수를 맛보기 바란다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"89.9.  202p"}]}]}],"excerpt":{"characters":232,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
