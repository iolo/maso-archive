{"schemaVersion":2,"article":{"reference":"cd3-topic-0380","article_id":"cd3:article:topic-0380","issue_id":"cd3-9504","title":"라이브 오브 더 트라이어드","byline":null,"page":null,"status":"success","disc":"cd3","nativeReference":"topic-0380","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"95년 4월호 (p.181)"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"게임"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"작년 10월부터 인터넷 뉴스유저 그룹의 큰 관심사가 되어 왔던 둠 형식의 게임. 둠과 줄거리, 사용 방법은 물론 초기 화면도 거의 비슷하지만 둠보다 훨씬 잔인한 그래픽 묘사가 섬뜩할 정도. 둠의 동작에서 한걸음 앞으로 나아가 달리기, 180도 회전하기, 무기 버리기, 위/아래 보기 등의 기능이 추가됐다. 재미는 있지만 청소년에게는 권장할 만한 게임은 아니다."}]}]}],"excerpt":{"characters":221,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
