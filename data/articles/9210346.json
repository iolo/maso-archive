{"schemaVersion":2,"article":{"reference":"9210346","article_id":"cd1:article:9210346","issue_id":"maso-1992-10","title":"디베이스 프로그램에서 한글 출력을 매끄럽게","byline":null,"page":346,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"디베이스 프로그램에서"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"한글 출력을 매끄럽게"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"디베이스로 프로그램을 작성할 때, 일반적으로 한글용 에디터를 많이 사용한다. 그러나 조합형 한글 에디터나, 다른 에디터와 호환되지 않는 에디터로 프로그램을 작성하여 출력할 경우, 프린터와 호환되지 않아 출력에 문제가 발생한다. 이러한 한글 에디터의 문제점을 해결하기 위한 방안으로 완성형 한글 카드와 완성형 에디터가 널리 사용되고 있지만, 막상 업무용 프로그램을 작성하여 원하는 결과를 얻고자 출력을 시도하면 번번히 전혀 다른 결과가 출력되는 경우가 있다."}]}]}],"excerpt":{"characters":280,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
