{"schemaVersion":2,"article":{"reference":"cd3-topic-0280","article_id":"cd3:article:topic-0280","issue_id":"cd3-9501","title":"AEGIS","byline":null,"page":null,"status":"success","disc":"cd3","nativeReference":"topic-0280","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"95년 1월호 (p.143)"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"함대의 수호자"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"AEGIS는 사용자를 거대한 함정의 지휘자로 만들어 준다. 미 해군의 티콘데로가급 순양함인 에이지스를 타고 전쟁을 치룬다. 함정에는 최신의 무기와 탐지기가 갖추어져 있으며, 베테랑급 선원들이 함께 승선하고 있다. 하지만 중요한 것은 함장의 판단력과 결단이다. 함장의 순간적인 결정에 따라 사람, 함정, 함대의 생명이 좌우된다."}]}]}],"excerpt":{"characters":207,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
