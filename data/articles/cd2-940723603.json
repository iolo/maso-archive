{"schemaVersion":2,"article":{"reference":"cd2-940723603","article_id":"cd2:article:940723603","issue_id":"cd2-9407","title":"TextHeight와 TextWidth의 용도","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"940723603","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧7⟦field:vfld⟧.  236p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"박스기사 3"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧류한석⟦field:vfld⟧\n\n텍스트 문자열을 화면에 나타낼 때 그 공간을 결정하기 위하여 사용하는 방법에는 TextHeight와 TextWidth의 두 가지가 있다. 예를 들어, 그림박스에서 'Micro Software'의 길이를 알아내기 위해서는 'StrLen$ = Picture1.TextWidth(\"Micro Software\")'라고 해 주면 된다. \n하지만 이외에도 TextHeight와 TextWidth에는 또 다른 용도가 있는데, 이들을 ScaleHeight, ScaleWidth와 같이 사용함으로써 폼에서 텍스트를 중앙에 위치시킬 수 있다."}]}]}],"excerpt":{"characters":373,"paragraphs":3,"truncated":false},"listings":[],"details":"","media":[]}
