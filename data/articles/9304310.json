{"schemaVersion":2,"article":{"reference":"9304310","article_id":"cd1:article:9304310","issue_id":"maso-1993-04","title":"'92 컴퓨터 바이러스 결산 보고서","byline":null,"page":310,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"안철수의 컴퓨터노트"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"93년 2월 28일까지 발견된 IBM PC 바이러스는 부트 바이러스 24종, 파일 바이러스 46종, 부트/파일 바이러스 5종으로 모두 75종에 이른다. 이 중에 26종이 국산 바이러스로, 국내에서 발견된 전체 바이러스의 1/3에 해당한다. 이처럼 93년 초까지   PC를 활동 무대로 해악을 끼치고 있는 바이러스의 분석 결과를 발견한 순서대로 알아본다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"안철수의 컴퓨터노트"}]}]}],"excerpt":{"characters":220,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
