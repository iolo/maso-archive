{"schemaVersion":2,"article":{"reference":"cd3-topic-0332","article_id":"cd3:article:topic-0332","issue_id":"cd3-9509","title":"헨젤과 그레텔","byline":null,"page":null,"status":"success","disc":"cd3","nativeReference":"topic-0332","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"95년 9월호 (p.189)"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"그림 동화"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"독일의 그림형제가 지은 헨젤과 그레텔이라는 동화를 멀티미디어화한 제품. 배경 음악과 함께 동화 내용을 보고 들을 수 있다. 배경 화면에서 숨은 그림을 찾으면서 게임을 즐길 수 있고, '그림형제' 메뉴를 통해 그림형제의 소개와 독일에 대한 설명을 들을 수 있다."}]}]}],"excerpt":{"characters":168,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
