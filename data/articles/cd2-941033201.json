{"schemaVersion":2,"article":{"reference":"cd2-941033201","article_id":"cd2:article:941033201","issue_id":"cd2-9410","title":"시스템 카탈로그","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"941033201","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧10⟦field:vfld⟧.  332p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"박스기사 1"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧김동욱⟦field:vfld⟧ ⟦field:vfld22⟧김재건⟦field:vfld⟧\n\n시스템 카탈로그는 시스템 자체에 관련 있는 다양한 객체들, 즉 뷰, 인덱스, 사용자, 응용 계획, 접근(access) 권한 등에 관한 정보(때로는 `설명서'라고 부른다)를 포함하는 시스템 데이터베이스이다. 관계 시스템에서는 이러한 카탈로그 자체 또한 보통 사용자 데이터 테이블과 같은 테이블로 구성되어 관계형 연산으로 검색할 수 있다. 물론 ODBC API는 데이터 소스에 대한 시스템 테이블이나 카탈로그에 대한 정보를 반환하는 함수를 지원한다. 다음 <표 1>에 모아 놓은 것이 바로 시스템 카탈로그 정보를 얻는 데 사용되는 함수이다."}]}]}],"excerpt":{"characters":411,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
