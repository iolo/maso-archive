{"schemaVersion":2,"article":{"reference":"cd2-941222201","article_id":"cd2:article:941222201","issue_id":"cd2-9412","title":"고정관념을 깨자","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"941222201","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧12⟦field:vfld⟧.  222p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"박스기사"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧류한석⟦field:vfld⟧\n\n파워유저라 해도 이상하게 자신의 컴퓨터 환경에 대한 고정관념을 가지고 있는 경우를 종종 볼 수 있다. 분명 새로운 것으로 바꾸면 편리함과 함께 작업능률을 배로 올릴 수 있음에도 자신의 손에 익은 것을 버리지 못하는 것이다. 물론 이것이 당장 시간적 여유가 없기 때문이라면 어쩔 수 없겠으나 새로운 것에 대한 막연한 거부감이나 매너리즘 때문이라면 그 사람은 이미 파워유저로서의 자격을 상실하고 만 것이다. 고정관념중 대표적인 것은 다음 두 가지이다."}]}]}],"excerpt":{"characters":329,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
