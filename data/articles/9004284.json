{"schemaVersion":2,"article":{"reference":"9004284","article_id":"cd1:article:9004284","issue_id":"maso-1990-04","title":"커밋 규약","byline":null,"page":284,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"통신과 파일 전송 규약 [6]"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"지금까지 이 연재에서 다룬 파일 전송 규약들은 대부분 개인용 컴퓨터간의 파일 전송을 위한 목적으로 제작된 것들이었다. 하지만 대형 컴퓨터와 개인용 컴퓨터간의 통신이 빈번해짐에 따라, 여러 종류의 컴퓨터간의 파일 전송에 적합한 새로운 파일 전송 규약의 필요성이 대두되기 시작했다. 이번 호에서는 주로 대형 컴퓨터와 개인용 컴퓨터간의 파일 전송을 목적으로 만들어진 커밋(Kermit) 규약에 대해서 알아본다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"통신과 파일 전송 규약"}]}]}],"excerpt":{"characters":257,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
