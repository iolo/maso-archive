{"schemaVersion":2,"article":{"reference":"9101194","article_id":"cd1:article:9101194","issue_id":"maso-1991-01","title":"폭스프로로 작성한 의국 및 환자 관리 시스템","byline":null,"page":194,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"의국 및 환자 관리 시스템은 의사들의 과모임인 의국의 각종 업무들, 즉 환자들의 병적/인적 관리, 수술환자 등록 및 수술 노트 작성, 의국 일정계획서, 주기별 환자 보고서 작성, 동문회원 관리와 발송지 출력, 그리고 각종 논문 및 저널 참조에 이르기까지 의국 내에서 일어나는 복잡하고도 반복적인 업무들을 관리해주는 프로그램이다."}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"폭스프로로 작성한"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"의국 및 환자 관리 시스템"}]}]}],"excerpt":{"characters":209,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
