{"schemaVersion":2,"article":{"reference":"cd2-940835801","article_id":"cd2:article:940835801","issue_id":"cd2-9408","title":"폰트의 이해","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"940835801","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧8⟦field:vfld⟧.  358p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"박스기사 1"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧박재홍⟦field:vfld⟧\n\n그래픽 모드에서 사용되는 프로그램들을 보면 화살표나 특정한 모양들이 반복적으로 사용되는 것을 볼 수 있다. 윈도우즈에 보면 많은 아이콘들이 등장하는데 각각을 나타내기 위해서 조그마한 그림으로 표현이 되어 있을 것이다. 또 게임에서 전투기나 총알 등이 화면 이곳저곳을 돌아다니고 있는 것이 보인다. 그렇다면 이들을 어떻게 프로그램 상으로 그리는 것일까?"}]}]}],"excerpt":{"characters":276,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
