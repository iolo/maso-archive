{"schemaVersion":2,"article":{"reference":"cd3-topic-0517","article_id":"cd3:article:topic-0517","issue_id":"cd3-9512","title":"'95 한국 소프트웨어 산업을 진단한다.","byline":null,"page":null,"status":"success","disc":"cd3","nativeReference":"topic-0517","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"95년 12월호 (p.202)"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"특별 좌담회"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"♣ 95년 컴퓨팅 환경은 이제 96년을 향해 쉼없는 변화를 계속하고 있고, 96년은 더욱 빠른 변화로 개발자와 사용자를 어리둥절하게 할 것이다. 개발자는 물론 PC 업계에 관련된 사람이라면 이런 급격한 변화에 어떻게 대처할 것인가가 가장 큰 관심사가 아닐 수 없다. 이런 의미에서 한국 소프트웨어 산업에서 중요한 위치를 차지하고 있는 7명이 모여 95년 한 해 한국 소프트웨어 산업을 돌아보며 성과와 문제점을 진단하고, 이를 토대로 96년을 내다볼 수 있는 자리를 마련했다. ♣"}]}]}],"excerpt":{"characters":292,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
