{"schemaVersion":2,"article":{"reference":"9108364","article_id":"cd1:article:9108364","issue_id":"maso-1991-08","title":"클리퍼로 작성한 국민학교 교육계획 기초자료 작성 프로그램","byline":null,"page":364,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"새 학기가 시작되면, 국민학교 교사들은 방대한 량의 교육계획 기초자료를 작성한다. 교육계획 기초자료는 1년 중 수업일수와 공휴일, 과목당 시간배당 계획, 그리고 교과내용 입력현황 등 1년치의 학교 운영과 교육계획표로 매년 똑같은 계획표를 반복적으로 작성하는 수고를 해야 했다. 그러나 여기 소개하는 국민학교 교육계획 기초자료 작성 프로그램은 이러한 교사들의 번거로움과 바쁜 일손을 간단히 덜어 줄 것이다."}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"클리퍼로 작성한"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"국민학교 교육계획 기초자료 작성 프로그램"}]}]}],"excerpt":{"characters":259,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
