{"schemaVersion":2,"article":{"reference":"cd2-940441011","article_id":"cd2:article:940441011","issue_id":"cd2-9404","title":"CMOS 셋업이 모두 지워져","byline":null,"page":null,"status":"success","disc":"cd2","nativeReference":"940441011","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.4.  410p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"시스템에서"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"음악 프로그램을 사용 중에 시스템이 다운되어 컴퓨터를 껐다 켰습니다. 그런데 컴퓨터를 켜니 `cmos checksum error'라는 메시지가 나오면서, CMOS 셋업을 다시 하라는 말이 나오더군요. 그래서 CMOS 셋업을 보니 모든 사양이 설정되어 있지 않은 걸로 되어 있습니다. 이런 경우는 처음이라 어떻게 해야 할지 모르겠어요. 다른 것은 몰라도 제가 저장한 글이나 데이터가 없어지면 안되는데 걱정이 됩니다. 꼭 도와주세요"}]}]}],"excerpt":{"characters":258,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
