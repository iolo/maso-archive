{"schemaVersion":2,"article":{"reference":"9301234","article_id":"cd1:article:9301234","issue_id":"maso-1993-01","title":"윤곽선 추출","byline":null,"page":234,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"벡터 폰트 자동 생성기, 추사체 [1]"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"연재 첫 회인 이번 호에는 벡터 폰트 자동 생성기인 `추사체' 의 전체적인 구조와 기능을 알아 보고, 벡터 폰트 생성의 첫 단계인 폰트 이미지 파일를 불러 오고 원래 화상에서 문자 이미지를 추출하는 과정을 알아 본다. 그리고 폰트 생성의 핵심 부분인 이미지의 윤곽선 추출에 필요한 벡터 코드를 생성하는 과정도 함께 다룬다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"벡터 폰트 자동 생성기, 추사체"}]}]}],"excerpt":{"characters":221,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
