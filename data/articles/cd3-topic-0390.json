{"schemaVersion":2,"article":{"reference":"cd3-topic-0390","article_id":"cd3:article:topic-0390","issue_id":"cd3-9504","title":"Flash Traffic","byline":null,"page":null,"status":"success","disc":"cd3","nativeReference":"topic-0390","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"95년 4월호 (p.185)"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"액션 영화의 주인공이 되자"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"늦은 밤, 마약단속반이 급습한 아지트에는 마약 대신 핵폭탄 제조 시설이 발견되고, 때를 맞춰 테러리스트들의 협박 전화가 걸려 온다. 그들이 준 여유 시간은 단 24시간. 정부는 국가 최고 위기령인 Flash Traffic을 선포함과 동시에 FBI에게 범인 체포와 핵폭탄 해체를 명령한다. 이제 이 게임 안에서 FBI 수사 요원이 되어 범인을 잡아야 한다."}]}]}],"excerpt":{"characters":230,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
