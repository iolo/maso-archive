{"schemaVersion":2,"article":{"reference":"9010218","article_id":"cd1:article:9010218","issue_id":"maso-1990-10","title":"맥월드 박람회를 통해 본 매킨토시 최근 동향","byline":null,"page":218,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"이번 박람회에서 강조가 된 분야는 역시 컬러 디스플레이 분야와 멀티미디어에 관계되는 분야라고 할 수 있다. 매킨토시를 이용한 비디오의 편집과 비디오 화면을 훔치는 기능, 컬러 화면을 모니터에서 이상적으로 구현하는 기술, CD 롬 디스크들, 비디오 CD 롬 디스크와 드라이브 따위가 많은 사람들의 관심을 끌었다."}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"맥월드 박람회를 통해 본"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"매킨토시 최근 동향"}]}]}],"excerpt":{"characters":199,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
