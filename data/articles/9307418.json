{"schemaVersion":2,"article":{"reference":"9307418","article_id":"cd1:article:9307418","issue_id":"maso-1993-07","title":"도스 6.0, 기본 메모리를 700KB까지 확장한다","byline":null,"page":418,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"도스 6.0"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"기본 메모리를 700KB까지 확장한다"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"도스용 프로그램을 사용하다 보면 메모리가 부족해 제대로 실행되지 않는 경우가 있다. 예를 들어 도스 6.0의 디스크 최적화 프로그램인 DEFRAG를 실행할 때 하드 디스크 용량이 클 경우 기본 메모리가 600KB일지라도 `Out of memory' 라는 에러 메시지가 출력되며 프로그램이 실행되지 않는다."}]}]}],"excerpt":{"characters":199,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
