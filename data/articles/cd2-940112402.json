{"schemaVersion":2,"article":{"reference":"cd2-940112402","article_id":"cd2:article:940112402","issue_id":"cd2-9401","title":"명인 2.0","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"940112402","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld11⟧1⟦field:vfld⟧.  124p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"개인 정보관리프로그램"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"칼럼/ 소프트웨어 열람실\n회사/ ⟦field:vfld12⟧피코소프트⟦field:vfld⟧\n제품명/ ⟦field:vfld13⟧명인 2.0⟦field:vfld⟧\n\n늘어나는 정보를 관리하는 것은 기업뿐 아니라 개인에게도 필요한 일이다. 최근들어 급증하고 있는 개인 정보 관리 프로그램(PIMS)의 개발도 이러한 필요에 기인한 것이다. 편리한 인터페이스가 돋보이는 피코소프트의 명인 2.0도 명함관리, 일정관리 등의 개인 정보를 관리해주는 프로그램으로 지난 93년 초 발표한 l.0 버전을 최근 업그레이드한 것이다."}]}]}],"excerpt":{"characters":335,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
