{"schemaVersion":2,"article":{"reference":"cd2-941137201","article_id":"cd2:article:941137201","issue_id":"cd2-9411","title":"LCK(Library Construction Kit)란","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"941137201","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧11⟦field:vfld⟧.  372p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"박스기사"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧박장선⟦field:vfld⟧\n\n말 그대로 마이크로소프트의 폭스프로용 라이브러리를 개발하는 키트이지만 사실 통합 환경이나 비주얼 환경은 없고 C 루틴을 폭스프로에서 쓸 수 있게 하거나, 좀 더 확장된 폭스프로 API를 가지고 있을 뿐이다.\n도스용과 윈도우즈용 모두 개발할 수 있으며 도스용은 .PLB, 윈도우즈용은 .FLL로 생성된다. 기본적으로 통합 헤더 파일인 PRO_EXT.H와 각종 라이브러리 파일이 제공되는데, 컴파일러로는 마이크로소프트 C/C++ 7.0 상위 버전과 왓콤 C 8.5 상위 버전을 권장하고 있다. 하지만 헤더 파일인 PRO_EXT.H를 약간만 수정하면 볼랜드의 컴파일러 C/C++ 계열로도 가능하다."}]}]}],"excerpt":{"characters":410,"paragraphs":3,"truncated":false},"listings":[],"details":"","media":[]}
