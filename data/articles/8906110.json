{"schemaVersion":2,"article":{"reference":"8906110","article_id":"cd1:article:8906110","issue_id":"maso-1989-06","title":"C의 배열과 포인터","byline":null,"page":110,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"베이직에서 C로 [6]"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"이번 호에서는 C의 배열과 포인터에 대해 설명하겠다. 일련된 공간에 저장된 자료의 집합인 배열은 베이직에 익숙한 독자에게 별로 어려운 부분이 아니다. 반면 포인터는 다른 언어가 가지고 있지 않은 C 언어 고유의 특징으로서 C 입문자에게 가장 이해하기 어려운 부분중의 하나이다. 그러나 다른 변수의 주소를 기억하는 기능을 가진 포인터를 알아두면 다양한 테크닉을 구사하는데 많은 도움이 될 것이다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"베이직에서 C로"}]}]}],"excerpt":{"characters":243,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
