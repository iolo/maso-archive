{"schemaVersion":2,"article":{"reference":"cd3-topic-0373","article_id":"cd3:article:topic-0373","issue_id":"cd3-9512","title":"Vocabulary 22000 X-Press","byline":null,"page":null,"status":"success","disc":"cd3","nativeReference":"topic-0373","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"95년 12월호 (p.191)"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"영어 단어 학습 프로그램"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"단어 암기 교재로 많은 사랑을 받아오던 헤럴드 레빈의 Vocabulary 22000을 타이틀화한 제품. 22,000개를 이용한 간이사전은 물론 단어를 연상하기 쉬운 이미지와 음성 지원으로 쉽게 단어를 익힐 수 있도록 한다. 그리고 단어장을 직접 만들거나 이를 프린트, 휴대성을 부여하고 직접 입력해 보면서 암기할 수 있도록 배려해 놓았으며, 학습 진도와 자기 성적을 관리함으로써 독학으로 인해 느슨해지기 쉬운 학습 효과를 높였다. 또한 책과 비슷하게 페이지 형태로 되어 있어 손에 익음은 물론 단축키와 네비게이션 기능으로 원하는 내용을 빠르게 찾을 수 있다."}]}]}],"excerpt":{"characters":344,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
