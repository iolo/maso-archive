{"schemaVersion":2,"article":{"reference":"9002186","article_id":"cd1:article:9002186","issue_id":"maso-1990-02","title":"방어를 위한 역탐지","byline":null,"page":186,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"해커 vs 프로텍터 [3]"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"디지털 통신의 대부분은 패킷교환이라는 정보교환방식을 채택하고 있다. 패킷의 형식은 일반 소포의 수신인명을 쓰는 것과 유사해서, 데이터의 시작과 끝을 나타내주는 정보, 데이터의 길이, 수신국의 어드레스 번호, 송신국의 어드레스 번호 등을 포함하고 있다. 때문에 '패킷'의 정보를 이용하면 어디로부터 해커가 침입해왔는지를 역탐지할 수 있는 것이다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"해커 vs 프로텍터"}]}]}],"excerpt":{"characters":219,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
