{"schemaVersion":2,"article":{"reference":"cd3-topic-0346","article_id":"cd3:article:topic-0346","issue_id":"cd3-9510","title":"말콤의 복수","byline":null,"page":null,"status":"success","disc":"cd3","nativeReference":"topic-0346","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"95년 10월호 (p.191)"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"또 다른 전설의 시작"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"유명한 게임인 키란디아의 전설의 세번째 시리즈로 3차원 랜더링 이미지와 디지털 음성을 통해 생생한 게임을 제공한다. 궁중의 광대인 말콤은 키란디아의 왕과 왕비를 살해한 벌로 돌로 변했지만, 사고로 인해 다시 자유로 돌아오자 복수를 결심하게 된다. 이에 마법과 간교한 꾀, 영리하고도 괴상한 변장을 통해 고양이들의 섬과 불가사의의 동굴에 얽힌 비밀을 밝혀내야 한다. 사용자가 악인이 되어 운용하는 어드벤처 게임이지만 새로운 세계로 독자 여러분을 인도할 것이다."}]}]}],"excerpt":{"characters":286,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
