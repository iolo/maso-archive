{"schemaVersion":2,"article":{"reference":"9206206","article_id":"cd1:article:9206206","issue_id":"maso-1992-06","title":"화면 스크롤 기법","byline":null,"page":206,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"터보 C로 구현한 화면제어 [2]"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"`이야기' 를 사용해본 독자라면 화면이 좌우로 스크롤되며 갈라지는 멋진 장면을 기억하고 있을 것이다. 어떻게 저런 걸 구현했을까? 나도 한 번 만들어 보았으면 하는 독자들을 위해 화면을 마음대로 스크롤 할 수 있는 방법과 SCREEN.LIB에서 제공하는 스크롤 함수를 소개한다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"터보 C로 구현한 화면제어"}]}]}],"excerpt":{"characters":190,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
