{"schemaVersion":2,"article":{"reference":"9101262","article_id":"cd1:article:9101262","issue_id":"maso-1991-01","title":"설계를 위한 준비","byline":null,"page":262,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"디지털 회로 설계 [1]"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"\"소프트웨어를 주로 다루는 잡지에 하드웨어를 제작하는 내용을, 더구나 기초적인 내용이 아닌 것을 게재한다는 것에 대해 우려가 되지만 많은 독자들이 하드웨어에 대해 알고 싶어하고, 특히 단지 소개에 그치는 기사보다는 뭔가 새로운 하드웨어를 만들어 보고 싶어하는 것 같아 한 번 시도해 보려고 한다. 사실 하드웨어에 관심은 있어도 실제로 제작에 뛰어들기가 힘든 것은 이론만으로는 구체화될 수 없고, 또 다양한 지식과 도구가 필요하기 때문일 것이다.\""}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"디지털 회로 설계"}]}]}],"excerpt":{"characters":274,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
