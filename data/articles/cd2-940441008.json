{"schemaVersion":2,"article":{"reference":"cd2-940441008","article_id":"cd2:article:940441008","issue_id":"cd2-9404","title":"뻥튀기한 부분이 부트되지 않아","byline":null,"page":null,"status":"success","disc":"cd2","nativeReference":"940441008","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.4.  410p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"스태커로"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"저는 105MB짜리 하드 디스크를 사용하고 있는데, 반을 나누어서 하나는 그냥 쓰고 하나는 스태커로 뻥튀기를 하여 쓰고 있습니다. 그런데 어느날 CONFIG.SYS와 AUTOEXEC.BAT를 새로 짜고 나서 멀티 부팅을 실행시키니 뻥튀기를 하지 않은 부분은 잘 되는데,  스태커를 사용한 부분이 write protected 에러가 납니다. 스왑 드라이브에 STACKER.LOG와 히든 파일은 그대로 있는데, 다시 살릴 수 있겠습니까?"}]}]}],"excerpt":{"characters":260,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
