{"schemaVersion":2,"article":{"reference":"cd2-940620000","article_id":"cd2:article:940620000","issue_id":"cd2-9406","title":"툴북으로 타이틀 만들기","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"940620000","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧6⟦field:vfld1⟧.  200p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"<특집 3> 현명한 프로그래머의 선택, 멀티미디어로 승부하자"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧유영우⟦field:vfld⟧\n\n멀티미디어 툴북은 가격이 저렴하면서도 사용하기가 쉬워 가장 대중적인 사용 기반을 갖고 있는 오소링 툴이다. 물론 오픈스크립트라는 자체 프로그래밍 언어를 사용해 코딩해야 하기 때문에 초보자가 배우기 어렵다는 면도 있지만 전문적으로 타이틀을 개발하고자 할 때는 사운드, 애니메이션, 동화상 등 기능 제한이 별로 없는 툴북이 제격이다. 백문이 불여일견! 지금부터 툴북을 사용해 간단한 프로그램을 만들면서 툴북의 강력함과 타이틀 개발의 실제를 경험해 보자."}]}]}],"excerpt":{"characters":359,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
