{"schemaVersion":2,"article":{"reference":"cd3-topic-0230","article_id":"cd3:article:topic-0230","issue_id":"cd3-9506","title":"뽀빠이 1.00","byline":null,"page":null,"status":"success","disc":"cd3","nativeReference":"topic-0230","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"95년 6월호 (p.179)"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"뽀빠이 만화 스크린 세이버"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"물고기 떼가 모니터 화면 안에서 돌아 다니기도 하고, 영화 주인공이 모니터 화면에서 총을 쏘는 등 재미있는 캐릭터가 등장하는 스크린 세이버. 하지만 스크린 세이버 특성상 한가지 종류만 오래동안 사용하는 경우는 별로 없다. 저마다 특색있는 화면을 구성하기 위해 수많은 스크린 세이버를 사용해 보곤하는 것이다. 여기 소개하는 뽀빠이 1.0은 스크린 세이버 프로그램으로 유명한 아프터 닥 3.0 (After Dark)과 거의 유사한 프로그램으로 기본 인터페이스나 화면 구성이 상당히 흡사하다."}]}]}],"excerpt":{"characters":304,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
