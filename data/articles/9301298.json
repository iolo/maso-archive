{"schemaVersion":2,"article":{"reference":"9301298","article_id":"cd1:article:9301298","issue_id":"maso-1993-01","title":"256컬러를 지원하는 그래픽 라이브러리, ET4K256","byline":null,"page":298,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"ET4K256은 홍익대 안내 시스템에 사용된 그래픽 라이브러리를 수정, 보완한 것으로 ET4000 카드가 제공하는 256컬러를 모두 지원하는 그래픽 라이브러리이다. ET4K256은 원, 사각형, 그리고 그래픽 한글에 이르기까지 다양한 그래픽 라이브러리를 제공하여, 독자 여러분은 그래픽 함수를 일일이 작성하는 번거로움없이 다양한 그래픽 기능을 제공하는 프로그램을 작성할 수 있을 것이다."}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"256컬러를 지원하는 그래픽 라이브러리"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"ET4K256"}]}]}],"excerpt":{"characters":247,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
