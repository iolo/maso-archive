{"schemaVersion":2,"article":{"reference":"cd2-940212602","article_id":"cd2:article:940212602","issue_id":"cd2-9402","title":"21세기 1.4","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"940212602","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld11⟧2⟦field:vfld⟧.  126p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"워드프로세서"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"칼럼/ 소프트웨어열람실\n회사/ ⟦field:vfld12⟧이스트소프트⟦field:vfld⟧\n제품명/ ⟦field:vfld13⟧21세기 1.4⟦field:vfld⟧\n\n한글 워드프로세서 21세기는 PC통신망을 통한 공개 프로그램으로 첫 출발을 시작한 소프트웨어지만, 현재 버전 1.4는 상업용 소프트웨어로 판매되고 있다. 21세기는 워드프로세서로는 상당히 낮은 가격인 2만7천5백원에 판매되는데다 기능면에서도 일반적인 문서 편집 시 큰 불편함을 느끼지 않는 다양한 기능을 갖고 있어 가격대 성능면에서 경쟁력을 확보하고 있다."}]}]}],"excerpt":{"characters":336,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
