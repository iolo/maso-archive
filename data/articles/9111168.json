{"schemaVersion":2,"article":{"reference":"9111168","article_id":"cd1:article:9111168","issue_id":"maso-1991-11","title":"IBM 입출력 장치와 애드온들","byline":null,"page":168,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"IBM PC 출현 10년, 그 이후"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"이 글에서는 IBM PC의 핵인 메인보드 외의 기타 구성 요소들에 대해 알아본다. IBM PC의 성장을 뒷받침해 온 빼놓을 수 없는 요소들, 즉 기본 시스템 구성에 속하는 키보드 및 비디오 디스플레이와 그 부가적 지원 요소인 애드온들을 점검해 봄으로써 작으면서도 큰 거인 `수퍼 마이크로 IBM PC'의 지난 10년간 흐름을 추적해 본다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"IBM PC 출현 10년, 그 이후"}]}]}],"excerpt":{"characters":230,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
