{"schemaVersion":2,"article":{"reference":"cd2-941010200","article_id":"cd2:article:941010200","issue_id":"cd2-9410","title":"프로그래머도 사람이다","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"941010200","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧10⟦field:vfld1⟧.  102p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"개발자 메시지"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧황태욱⟦field:vfld⟧\n\n사람은 늘 어떻게 하면 훌륭한 삶을 살 수 있을까 생각하고 고민한다. 그에 못지 않게 풀그림(프로그램)을 만드는 사람은 어떻게 하면 훌륭한 풀그림꾼(프로그래머)으로 살아 갈 수 있을까를 생각한다. 필자는 이 글을 읽는 사람은 일단 훌륭한 사람으로 사는 삶에 대해서는 충분히 생각했다고 보고, 이것과 비교하여 훌륭한 풀그림꾼으로 사는 방법에 대해 느낀 것을 몇 마디 적는다."}]}]}],"excerpt":{"characters":291,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
