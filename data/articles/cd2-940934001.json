{"schemaVersion":2,"article":{"reference":"cd2-940934001","article_id":"cd2:article:940934001","issue_id":"cd2-9409","title":"어도비 프리미어","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"940934001","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧9⟦field:vfld⟧.  340p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"박스기사"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧홍영민⟦field:vfld⟧\n\n어도비의 프리미어(Premiere)는 동화상 전문 편집 소프트웨어로 유명한 프로그램이다. 이 소프트웨어는 현재 버전 3.0까지 나와 있는 것으로 알고 있는데, 필자는 아쉽게도 1.0 버전까지밖에 사용해 보지 못했다. 버전 1.0은 93년에 발표된 소프트웨어로 필자에게 신선한 충격을 안겨 주었던 기억이 생생하다. 이 소프트웨어는 윈도우즈에서 사용되는 대다수의 미디어 파일 형식을 지원해 줌으로써 비디오 파일 편집과 변환에 대한 훌륭한 해결책을 제공해 준다. 지원되는 파일 형식은 다음과 같다."}]}]}],"excerpt":{"characters":353,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
