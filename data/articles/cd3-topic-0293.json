{"schemaVersion":2,"article":{"reference":"cd3-topic-0293","article_id":"cd3:article:topic-0293","issue_id":"cd3-9506","title":"타임 온 타겟","byline":null,"page":null,"status":"success","disc":"cd3","nativeReference":"topic-0293","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"95년 6월호 (p.187)"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"3차원 액션 게임"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"타이틀과 같이 제공되는 안경을 쓰면 입체 영상을 즐길 수 있다. 입체용 안경은 붉은색과 파란색의 색상 차를 이용하는 것으로 사실감을 느끼게 해 준다. 게임 진행 방법이 루카스 아츠사의 '제국의 역습'과 비슷하며 계곡, 터널, 도시 등의 다양한 단계를 접할 수 있다."}]}]}],"excerpt":{"characters":175,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
