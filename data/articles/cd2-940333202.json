{"schemaVersion":2,"article":{"reference":"cd2-940333202","article_id":"cd2:article:940333202","issue_id":"cd2-9403","title":"다락방의 소스 파일","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"940333202","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧3⟦field:vfld⟧.  332p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"박스기사 2"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧황기태⟦field:vfld⟧ 외 4인\n\n다락방을 구성하는 파일들을 <표 1>에 정리해 보았는데 파일이 워낙 많아서 빠진게 있는지 확인하기도 힘들 정도이다. 그리고 이 파일만 가지고는 다락방이 실행되지 않는다. 이유는 <표 1>에 나타난 파일들은 C++ 소스만 있으며, 그외 버튼 등을 생성할때 사용하는 파일도 여러 개 있고, 그 중 몇 개는 DLL(Dynamic link libraries)로 작성되어 있다. 또한 나중에 급하게 추가하게 된 것은 그냥 비트맵을 리소스에서 로드하여 사용하는 방법을 썼으므로 그 파일이 필요하다. 참고로 여기에 소개된 파일은 소스로 제공되니 연재가 진행되는 동안 참고하기 바란다."}]}]}],"excerpt":{"characters":404,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
