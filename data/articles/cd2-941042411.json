{"schemaVersion":2,"article":{"reference":"cd2-941042411","article_id":"cd2:article:941042411","issue_id":"cd2-9410","title":"0바이트 파일을 복사하려면","byline":null,"page":null,"status":"success","disc":"cd2","nativeReference":"941042411","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.10.  424p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"도스"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"때로는 크기가 0바이트인 파일을 복사해야 할 경우가 있을 것이다. 하지만 COPY 명령을 사용하면 `0개의 파일이 복사되었다' 는 메시지와 함께 복사가 되지 않는다. 이런 경우 `COPY CON 파일 이름' 명령을 사용할 수도 있으나, 파일 이름 외에 파일 생성 일자와 같은 정보도 필요한 경우에는 적합한 방법이 아니다. 이를 해결하기 위해서는 XCOPY 명령을 사용하면 된다."}]}]}],"excerpt":{"characters":228,"paragraphs":3,"truncated":false},"listings":[],"details":"","media":[]}
