{"schemaVersion":2,"article":{"reference":"9203352","article_id":"cd1:article:9203352","issue_id":"maso-1992-03","title":"유능한 비서 사공정 1.5","byline":null,"page":null,"status":"normalized","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"유능하고 능숙한 비서, 사공정 1.5를 소개한다. 데이터베이스 패키지로서의 왕좌 다툼을 벌이고 있는 폭스프로와 클리퍼의 장점을 활용해 작성한 사공정 1.5는 깨끗한 색상과 그림자 효과로 산뜻한 화면과 편리한 일정관리, 그리고 짜임새 있는 출력 루틴 등 다채로운 기능을 갖춘 본격 개인 업무 프로그램이다."}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"92.3.  352p"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ 이점한"}]}]}],"excerpt":{"characters":189,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
