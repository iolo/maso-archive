{"schemaVersion":2,"article":{"reference":"cd3-topic-0360","article_id":"cd3:article:topic-0360","issue_id":"cd3-9511","title":"비디오나라","byline":null,"page":null,"status":"success","disc":"cd3","nativeReference":"topic-0360","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"95년 11월호 (p.191)"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"비디오 가이드"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"어린이 교육용으로 좋은 내용을 담고 있는 비디오에 대한 정보를 모아 놓은 타이틀. 영화, 만화 영화, 다큐멘터리에 대한 다양한 소개를 담고 있다. 이 타이틀에서 소개하는 비디오는 사고력과 감수성을 길러주는 데 효과적인 교육 자료. 연령별, 학년별로 적당한 비디오를 구성해 놓았으며 부모님과 어린이들이 그 내용에 대해 잘 알 수 있도록 포스터, 줄거리, 해설 및 동영상을 담아 놓았다. 또한 엄선되어 있는 300여편의 비디오에 대한 감독, 주연 배우, 수입·배급, 출시일, 상영 시간 등을 얻을 수 있기 때문에 자료 모음의 역할도 겸할 수 있다."}]}]}],"excerpt":{"characters":330,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
