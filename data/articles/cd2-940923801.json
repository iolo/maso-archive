{"schemaVersion":2,"article":{"reference":"cd2-940923801","article_id":"cd2:article:940923801","issue_id":"cd2-9409","title":"데이터 흐름도","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"940923801","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧9⟦field:vfld⟧.  238p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"박스기사"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧최은혁⟦field:vfld⟧\n\n데이터 흐름도(Data Flow Diagram)는 프로세스를 버블(bubble)로 나타내고 프로세스 사이의 데이터 흐름을 방향성 호(directed arc)를 이용해 표현한다(<그림 1>). 또한 중첩된 다이어그램을 계층적으로 나타내면서 상위 단계의 데이터 흐름도에서 프로세스로 표현된 내용은 하위 단계에서 자세히 표현된다(<그림 2>). 하지만 데이터 흐름도는 일정한 조건에 따른 흐름이나 제어 흐름(control flow)을 표현할 수 없다는 한계를 가진다."}]}]}],"excerpt":{"characters":336,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
