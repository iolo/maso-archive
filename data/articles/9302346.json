{"schemaVersion":2,"article":{"reference":"9302346","article_id":"cd1:article:9302346","issue_id":"maso-1993-02","title":"볼랜드 C++ 3.1 유용한 팁과 유틸리티","byline":null,"page":346,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"객체지향 프로그램의 대명사로 불리우는 볼랜드 C++ 3.1이 드디어 그 새로운 모습을 드러냈다. 비록 3.0에서 3.1로 업그레이드되었지만 3.0에 없던 무척 많은 기능이 첨가되었다. 이 글에서는 새로 추가된 기능 중 간단하지만 볼랜드 C++ 3.1을 더 유용하게 쓸 수 있는 몇 가지 팁과 유틸리티를 소개한다."}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"볼랜드 C++ 3.1"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"유용한 팁과 유틸리티"}]}]}],"excerpt":{"characters":199,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
