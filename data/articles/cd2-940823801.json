{"schemaVersion":2,"article":{"reference":"cd2-940823801","article_id":"cd2:article:940823801","issue_id":"cd2-9408","title":"결합도의 분류","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"940823801","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧8⟦field:vfld⟧.  238p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"박스기사 1"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧최은혁⟦field:vfld⟧\n\n결합도(Coupling)는 모듈간의 독립성을 나타내는 것으로, 모듈간의 결합도에 영향을 미치는 요소는 모듈간에 전달되는 데이터 항목 수, 제어 데이터 양, 그리고 모듈에 의해 공유된 전역 데이터 수이며, 이들 요소의 수나 양이 많으면 많을수록 결합도는 더욱 더 강해진다. \n결합도가 높은 순서대로 분류하면 다음과 같이 다섯 가지 종류가 있다."}]}]}],"excerpt":{"characters":271,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
