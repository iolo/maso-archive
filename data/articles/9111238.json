{"schemaVersion":2,"article":{"reference":"9111238","article_id":"cd1:article:9111238","issue_id":"maso-1991-11","title":"사용자 컬러 지정","byline":null,"page":238,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"256 컬러 그래픽 이미지 구현 [2]"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"256 컬러 그래픽 이미지 구현 두번째로, 이번 호에는 256컬러를 등록하는 사용자 컬러 지정과 256 컬러의 색구조에 대해 알아 보겠다. 중점적으로 공부할 내용은 색값을 결정하는 팔레트 레지스터와 디스플레이되는 색을 바꿀 수 있는 DAC 레지스터이다. 특히 256컬러를 사용하는 모드 선택시와 64컬러, 16컬러를 사용하는 모드 선택시의 설명은 매우 어려우므로 어셈블리 예제 프로그램을 충분히 활용하기 바란다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"256 컬러 그래픽 이미지 구현"}]}]}],"excerpt":{"characters":271,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
