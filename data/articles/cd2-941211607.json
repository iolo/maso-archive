{"schemaVersion":2,"article":{"reference":"cd2-941211607","article_id":"cd2:article:941211607","issue_id":"cd2-9412","title":"JAPAN 9","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"941211607","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld11⟧12⟦field:vfld⟧.  116p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"일본어 기초 회화 프로그램"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"칼럼/ 국내신제품\n회사/ ⟦field:vfld12⟧열음소프트⟦field:vfld⟧\n제품명/ ⟦field:vfld13⟧JAPAN 9⟦field:vfld⟧\n\n열음소프트가 개발한 JAPAN 9는 일본어 발음교정, 기초 회화, 실용 회화 등을 일본인 발음으로 들으면서 공부할 수 있는 일본어 기초 회화 학습 프로그램. 학습 단계에 따라 기본적인 문법과 단어를 학습할 수 있고, 단어 사전을 제공해 수시로 참조할 수 있다. 또한 각 상황마다 2인 또는 3인이 같이 대화할 수 있는 형식으로 학습할 수도 있다. 286 이상, 사운드 블래스터 호환 제품에서 실행 가능하다. 가격은 4만9천5백원(부가세 포함).\n문의처 : 열음소프트(919-0944)"}]}]}],"excerpt":{"characters":411,"paragraphs":3,"truncated":false},"listings":[],"details":"","media":[]}
