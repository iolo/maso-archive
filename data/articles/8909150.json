{"schemaVersion":2,"article":{"reference":"8909150","article_id":"cd1:article:8909150","issue_id":"maso-1989-09","title":"기억부류(storage class)의 정복","byline":null,"page":150,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"정복 터보 C [1]"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"8월호까지 연재되었던  베이직에서 C로 가 독자들의 많은 관심과 아쉬움을 남기면서 대단원의 막을 내렸다. 이로써 C에 입문을 원하던 여러 독자들의 갈증은 어느 정도 해소되었으리라 믿는다. 이제 좀더 욕심을 부려 C에서 가장 큰 난관이라 입을 모으는 포인터를 타겟으로 하여 터보 C를 신고 정복의 대장정에 올라, 이번 호에서는 먼저 험난한 여행에의 준비운동을 하고 다음 호부터 본격적인 등반을 시작하겠다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"정복 터보 C"}]}]}],"excerpt":{"characters":246,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
