{"schemaVersion":2,"article":{"reference":"cd2-940924401","article_id":"cd2:article:940924401","issue_id":"cd2-9409","title":"RND 함수에 관해","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"940924401","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧9⟦field:vfld⟧.  244p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"박스기사"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧류한석⟦field:vfld⟧\n\nRND 함수는 게임 등을 만들 때나 불규칙한 숫자를 발생시킬 때 사용하는 함수인데, 실제로 이 함수를 사용하게 되면 프로그램이 실행될 때마다 발생되는 난수가 똑같게 되어 버린다. 즉, 0.123456, 0.987654 등의 순서로 난수가 발생했다면 해당 프로그램이 다시 실행될 때도 똑같은 숫자가 만들어지게 되는 것이다.\n이와 같이 동일한 숫자들이 발생하는 것을 방지하기 위해서는, RND 함수를 사용하기전에 Randomize 문을 사용하여 주어야 한다. Randomize 문은 반복되지 않는 숫자를 만들기 위해 RND 함수를 초기화시키는 역할을 한다."}]}]}],"excerpt":{"characters":387,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
