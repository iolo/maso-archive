{"schemaVersion":2,"article":{"reference":"cd2-941111609","article_id":"cd2:article:941111609","issue_id":"cd2-9411","title":"번개돌이","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"941111609","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld11⟧11⟦field:vfld⟧.  116p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"통신 교육용 CD-ROM 타이틀"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"칼럼/ 국내신제품\n회사/ ⟦field:vfld12⟧네오미디어⟦field:vfld⟧\n제품명/ ⟦field:vfld13⟧번개돌이⟦field:vfld⟧\n\n네오미디어는 국내외 통신망을 사용하는 방법을 다룬 CD-ROM 타이틀 번개돌이를 발표했다. PC 통신 사용자가 기본적으로 알아야 할 사항과 통신 서비스 가입 방법부터 사용법, 시뮬레이션, 통신망별 특성, 동호회 등 다양한 정보를 담고 있다. 기본적인 학습 기능 이외에 하이퍼 텍스트를 이요한 검색 기능을 지원한다. 또한 번개돌이 CD-ROM에는 다양한 공개 소프트웨어를 24개 분야로 나누어 담았으며, 특히 자료실에는 프로그램을 한 눈에 볼 수 있는 뷰어 기능을 두었다. 가격은 미정.\n문의처 : 네오미디어(921-9880)"}]}]}],"excerpt":{"characters":434,"paragraphs":3,"truncated":false},"listings":[],"details":"","media":[]}
