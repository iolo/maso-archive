{"schemaVersion":2,"article":{"reference":"9001228","article_id":"cd1:article:9001228","issue_id":"maso-1990-01","title":"한글 입력기 홍두깨","byline":null,"page":null,"status":"reference_with_gaps","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"한글 입력기 홍두깨는 세벌식 자판을 지원해 주는 한글 오토마타이다. 한글 코드가 상용 조합형이면 사용 가능한 이 프로그램은 워드프로세서뿐만 아니라 데이터베이스, 스프레드시트 등의 일반 패키지에서도 세벌식 한글 자판으로 한글을 입력할 수 있도록 해준다. 물론 2벌식 자판도 지원한다."}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"90.1.  228p"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ 정내권"}]}]}],"excerpt":{"characters":177,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
