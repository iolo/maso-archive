{"schemaVersion":2,"article":{"reference":"9102234","article_id":"cd1:article:9102234","issue_id":"maso-1991-02","title":"메모리의 종류와 정의","byline":null,"page":234,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"확장 메모리의 활용 [1]"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"IBM PC를 사용하는 독자라면 누구나 640K 바이트의 메모리 한계에 부딪쳐 본 적이 있을 것이다. 확장 메모리에 대한 관심이 지대해지고 있는 요즈음, 독자 여러분에게 다양한 종류의 메모리와 그 사용법을 소개하는 기회를 제공하고자 5회에 걸친 연재를 마련하였다. 메모리의 종류와 사용법, 특히 연속확장 메모리와 중첩확장 메모리, 그리고 상위 메모리 공간의 활용을 모색해 온 독자 여러분에게 많은 도움이 될 것이다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"확장 메모리의 활용"}]}]}],"excerpt":{"characters":259,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
