{"schemaVersion":2,"article":{"reference":"9301290","article_id":"cd1:article:9301290","issue_id":"maso-1993-01","title":"클리퍼 링커, Bilinker","byline":null,"page":290,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"클리퍼 링커, Blinker"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"라이브러리 은행의 첫 클리퍼 라이브러리로 Blinker를 소개한다. 링커를 라이브러리 코너에서 소개한다는 것이 어찌 보면 이상하게 느껴질 수도 있지만, Blinker는 링커이면서도 클리퍼 프로그램에서 호출할 수 있는 함수가 내장되었다는 점에서 라이브러리로 분류할 수도 있다. 이 글에서는 Blinker의 메모리 관리 함수 등 각종 기능에 대해 알아 본다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"클리퍼 링커,Blinker"}]}]}],"excerpt":{"characters":230,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
