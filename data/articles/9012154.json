{"schemaVersion":2,"article":{"reference":"9012154","article_id":"cd1:article:9012154","issue_id":"maso-1990-12","title":"워드프로세서 아래한글 제작팀의 김형집","byline":null,"page":154,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"한글 워드프로세서하면 누구나 아래 한글을 말한다. 전문 프로그래머가 아닌 학생들이 모여 만들었다는데, 그들은 어떤 사람들인지, 또 아래한글이 만들어진 과정은 어떠했는지, 자칭 한글 제작팀의 감초라고 말하는 김형집씨를 만나 이야기를 나누었다. 공부 잘하는 장난꾸러기같은 김형집씨의 두꺼워 보이는 안경 뒤엔 하고 싶은 일이 많아 의욕에 차 있고, 어떤 일이든 해내고야 말 것 같은 야무진 눈동자가 있었다."}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"워드프로세서 아래한글 제작팀의"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"김형집"}]}]}],"excerpt":{"characters":246,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
