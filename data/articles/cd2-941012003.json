{"schemaVersion":2,"article":{"reference":"cd2-941012003","article_id":"cd2:article:941012003","issue_id":"cd2-9410","title":"스캔매직 컬러","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"941012003","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld11⟧10⟦field:vfld⟧.  120p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"컬러 핸디 스캐너"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"칼럼/ 해외신제품\n회사/ ⟦field:vfld12⟧머스텍⟦field:vfld⟧\n제품명/ ⟦field:vfld13⟧스캔매직 컬러 Ⅱ⟦field:vfld⟧\n\n머스텍이 출시한 스캔매직 컬러 II는 400dpi의 해상도에서 그레이스케일 이미지나 24비트 컬러 이미지를 스캔하거나 읽어 들일 수 있는 핸디 스캐너다. 이 제품은 24비트 컬러모드에서 1,600만 컬러를 표현할 수 있고, 12비트 모드에서는 4,096 컬러를 인식할 수 있다. 그래픽 편집 프로그램인 마이크로그래픽스의 포토매직 1.0과 문자 인식 프로그램인 퍼시브 퍼스널을 함께 제공한다. 299달러에 판매. \n제작회사 : Mustek(714-453-0110)"}]}]}],"excerpt":{"characters":394,"paragraphs":3,"truncated":false},"listings":[],"details":"","media":[]}
