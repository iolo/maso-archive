{"schemaVersion":2,"article":{"reference":"9305318","article_id":"cd1:article:9305318","issue_id":"maso-1993-05","title":"256컬러를 다 사용하자","byline":null,"page":318,"status":"prepared","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"라이브러리는 이렇게 만든다 [4]"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"이번 호에는 컬러의 무궁무진한 세계를 만끽할 수 있는 320X200 해상도의 256컬러 제어 라이브러리를 작성한다. 먼저 컬러를 구현하는 데 필요한 기초 사항을 알아보고, 256컬러의 비디오 모드인 0x13을 제어하는 함수를 구현한다. 그리고이를 이용해 작성한 256컬러 제어 프로그램인 X256.C를 소개하겠다."}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"라이브러리는 이렇게 만든다"}]}]}],"excerpt":{"characters":210,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
