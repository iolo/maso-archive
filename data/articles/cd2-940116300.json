{"schemaVersion":2,"article":{"reference":"cd2-940116300","article_id":"cd2:article:940116300","issue_id":"cd2-9401","title":"한글 TeX을 이용하려면","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"940116300","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧1⟦field:vfld1⟧.  163p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"<특집 2> TEX과 한글이 만나다"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧류성준⟦field:vfld⟧\n\n원래 TeX 자체는 공개 소프트웨어이지만, 크누스 교수가 TeX 환경을 상업화하지 않고 핵심 프로그램을 만든 후 각 기종별로 이식하는 등 작업 환경을 자유롭게 사용할 수 있도록 했기 때문에 독특한 기능의 상업용 패키지부터 개인용 사용자에게 알맞은 공개용 패키지까지 다양한 버전이 나와 있다. 그러면 과연 내 시스템에서는 어떤 버전의 TeX을 사용하는 것이 가장 효율적인지 알아 보자. 아울러 독자 자신의 기종에서 사용 가능한 TeX 환경과 추천하고 싶은 TeX 환경도 소개하겠다."}]}]}],"excerpt":{"characters":362,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
