{"schemaVersion":2,"article":{"reference":"cd3-topic-0240","article_id":"cd3:article:topic-0240","issue_id":"cd3-9508","title":"FORMATER","byline":null,"page":null,"status":"success","disc":"cd3","nativeReference":"topic-0240","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"95년 8월호 (p.184)"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"포맷을 빠르게"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"요즘이야 포맷된 디스켓이 판매되고 있지만 디스켓을 사면 꼭 포맷을 해야 하는 시절이 있었다. 하기야 요즘도 포맷된 디스켓이 판매된다고 하지만 포맷을 안할 수는 없다. 포맷을 하는 데 번거로움이나 시간이 걸리는 점을 해결하기 위해서는 포맷을 빠르고 깔끔하게 할 수 있는 디스켓 FORMATER가 있다."}]}]}],"excerpt":{"characters":192,"paragraphs":3,"truncated":true},"listings":[],"details":"","media":[]}
