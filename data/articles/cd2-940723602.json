{"schemaVersion":2,"article":{"reference":"cd2-940723602","article_id":"cd2:article:940723602","issue_id":"cd2-9407","title":"처음 나타날 윈도우 지정","byline":null,"page":null,"status":"partial","disc":"cd2","nativeReference":"940723602","path":"","text":null,"text_sha256":null,"paragraphs":3,"listings":0,"image_occurrences":0,"resources":[]},"blocks":[{"id":"excerpt-1","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p1","terminated":true,"runs":[{"type":"text","text":"94.⟦field:vfld21⟧7⟦field:vfld⟧.  236p"}]}]},{"id":"excerpt-2","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p2","terminated":true,"runs":[{"type":"text","text":"박스기사 2"}]}]},{"id":"excerpt-3","type":"paragraph","preformatted":false,"paragraphs":[{"id":"excerpt-p3","terminated":true,"runs":[{"type":"text","text":"글/ ⟦field:vfld22⟧류한석⟦field:vfld⟧\n\n컴퓨터를 켰을 때, 가장 먼저 나타나는 윈도우를 지정하기 위해서는 다음과 같이 하면 된다. 먼저 비주얼 베이직의 옵션 메뉴 중 'PROJECT'를 선택한 다음, 열리는 대화상자에서 'START UP FORM'을 선택하여 처음에 나타나기 원하는 폼의 이름을 설정해 주면 된다."}]}]}],"excerpt":{"characters":233,"paragraphs":3,"truncated":false},"listings":[],"details":"","media":[]}
