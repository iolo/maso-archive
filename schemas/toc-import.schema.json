{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MASO TOC import contracts, version 1",
  "$ref": "#/$defs/bundle",
  "$defs": {
    "issue_id": {"type": "string", "pattern": "^maso-19[0-9]{2}-(0[1-9]|1[0-2])$"},
    "entry_id": {"type": "string", "pattern": "^maso-19[0-9]{2}-(0[1-9]|1[0-2])-toc-[0-9]{4,}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "page": {"type": ["integer", "null"], "minimum": 1},
    "pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "kind": {"enum": ["section", "article", "subtopic", "unknown"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "line_start", "line_end", "raw_line"],
      "properties": {
        "id": {"type": "string", "pattern": "^toc-sha256-[0-9a-f]{64}$"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "raw_line": {"type": "string"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["toc", "body", "cover"],
      "properties": {
        "toc": {"const": "transcribed"},
        "body": {"enum": ["awaiting_scan", "not_matched"]},
        "cover": {"const": "not_inspected"}
      }
    },
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "year", "month", "original_label", "publication_date", "total_pages", "verification_status", "coverage", "source"],
      "properties": {
        "schema_version": {"const": 1}, "id": {"$ref": "#/$defs/issue_id"},
        "year": {"type": "integer", "minimum": 1900, "maximum": 1999},
        "month": {"type": "integer", "minimum": 1, "maximum": 12},
        "original_label": {"type": "string", "pattern": "^[0-9]{2}\\.(0[1-9]|1[0-2])$"},
        "publication_date": {"type": "null"}, "total_pages": {"type": "null"},
        "verification_status": {"const": "unreviewed"},
        "coverage": {"$ref": "#/$defs/coverage"}, "source": {"$ref": "#/$defs/source"}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "issue_id", "parent_id", "section_path", "order", "sibling_order", "indent", "depth", "raw_text", "source", "verification_status", "title_candidate", "byline_candidate", "contributor_candidates", "page_reference_raw", "page_candidates", "start_page_candidate", "end_page_candidate", "flags", "kind_candidate"],
      "properties": {
        "schema_version": {"const": 1}, "id": {"$ref": "#/$defs/entry_id"},
        "issue_id": {"$ref": "#/$defs/issue_id"},
        "parent_id": {"anyOf": [{"$ref": "#/$defs/entry_id"}, {"type": "null"}]},
        "section_path": {"type": "array", "items": {"$ref": "#/$defs/entry_id"}},
        "order": {"type": "integer", "minimum": 1},
        "sibling_order": {"type": "integer", "minimum": 1},
        "indent": {"type": "integer", "minimum": 0},
        "depth": {"type": "integer", "minimum": 0},
        "raw_text": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"}, "verification_status": {"const": "unreviewed"},
        "title_candidate": {"type": "string", "minLength": 1},
        "byline_candidate": {"type": ["string", "null"], "minLength": 1},
        "contributor_candidates": {"$ref": "#/$defs/strings"},
        "page_reference_raw": {"type": ["string", "null"]},
        "page_candidates": {"$ref": "#/$defs/pages"},
        "start_page_candidate": {"$ref": "#/$defs/page"},
        "end_page_candidate": {"type": "null"},
        "flags": {"$ref": "#/$defs/strings"}, "kind_candidate": {"$ref": "#/$defs/kind"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "toc_entry_id", "issue_id", "title_candidate", "byline_candidate", "contributor_candidates", "page_candidates", "start_page_candidate", "end_page_candidate", "section_path", "verification_status", "source_matches", "summary", "flags"],
      "properties": {
        "schema_version": {"const": 1},
        "id": {"type": "string", "pattern": "^maso-19[0-9]{2}-(0[1-9]|1[0-2])-article-[0-9]{4,}$"},
        "toc_entry_id": {"$ref": "#/$defs/entry_id"}, "issue_id": {"$ref": "#/$defs/issue_id"},
        "title_candidate": {"type": "string", "minLength": 1},
        "byline_candidate": {"type": ["string", "null"], "minLength": 1},
        "contributor_candidates": {"$ref": "#/$defs/strings"},
        "page_candidates": {"$ref": "#/$defs/pages"}, "start_page_candidate": {"$ref": "#/$defs/page"},
        "end_page_candidate": {"type": "null"},
        "section_path": {"type": "array", "items": {"$ref": "#/$defs/entry_id"}},
        "verification_status": {"const": "unreviewed"},
        "source_matches": {"type": "array", "maxItems": 0}, "summary": {"type": "null"},
        "flags": {"$ref": "#/$defs/strings"}
      }
    },
    "diagnostic": {
      "type": "object", "required": ["code", "line"],
      "properties": {"code": {"type": "string"}, "line": {"type": ["integer", "null"], "minimum": 1}}
    },
    "counter": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source_sha256", "errors", "counts", "issues", "diagnostics"],
      "properties": {
        "schema_version": {"const": 1}, "source_sha256": {"$ref": "#/$defs/hash"},
        "errors": {"type": "array", "maxItems": 0},
        "counts": {
          "type": "object", "additionalProperties": false,
          "required": ["issues", "entries", "article_candidates", "diagnostics", "entries_without_page_marker", "by_kind", "by_diagnostic"],
          "properties": {
            "issues": {"type": "integer", "minimum": 1}, "entries": {"type": "integer", "minimum": 1},
            "article_candidates": {"type": "integer", "minimum": 0},
            "diagnostics": {"type": "integer", "minimum": 0},
            "entries_without_page_marker": {"type": "integer", "minimum": 0},
            "by_kind": {"$ref": "#/$defs/counter"}, "by_diagnostic": {"$ref": "#/$defs/counter"}
          }
        },
        "issues": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["issue_id", "entries", "article_candidates", "coverage"],
          "properties": {
            "issue_id": {"$ref": "#/$defs/issue_id"}, "entries": {"type": "integer", "minimum": 1},
            "article_candidates": {"type": "integer", "minimum": 0}, "coverage": {"$ref": "#/$defs/coverage"}
          }
        }},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "issue_id", "raw_text", "depth"],
      "properties": {
        "id": {"$ref": "#/$defs/entry_id"}, "issue_id": {"$ref": "#/$defs/issue_id"},
        "raw_text": {"type": "string", "minLength": 1}, "depth": {"type": "integer", "minimum": 0}
      }
    },
    "identities": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "next_serial", "retired_ids", "entries"],
      "properties": {
        "schema_version": {"const": 1},
        "next_serial": {
          "type": "object", "propertyNames": {"$ref": "#/$defs/issue_id"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "retired_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/entry_id"}},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/identity"}}
      }
    },
    "decisions": {
      "type": "object", "additionalProperties": false,
      "required": ["source_sha256", "assignments", "removed_ids"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/hash"},
        "assignments": {
          "type": "object", "propertyNames": {"pattern": "^[1-9][0-9]*$"},
          "additionalProperties": {"$ref": "#/$defs/entry_id"}
        },
        "removed_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/entry_id"}},
        "new_lines": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[1-9][0-9]*$"}}
      }
    },
    "search": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "issue_id", "title", "byline", "pages", "kind_candidate", "verification_status", "search_text"],
      "properties": {
        "id": {"$ref": "#/$defs/entry_id"}, "issue_id": {"$ref": "#/$defs/issue_id"},
        "title": {"type": "string", "minLength": 1}, "byline": {"type": ["string", "null"]},
        "pages": {"$ref": "#/$defs/pages"}, "kind_candidate": {"$ref": "#/$defs/kind"},
        "verification_status": {"const": "unreviewed"}, "search_text": {"type": "string"}
      }
    },
    "bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["issues", "entries", "candidates", "report", "identities", "search"],
      "properties": {
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "report": {"$ref": "#/$defs/report"}, "identities": {"$ref": "#/$defs/identities"},
        "search": {"type": "array", "items": {"$ref": "#/$defs/search"}}
      }
    }
  }
}
