{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/maso/image-article.schema.json",
  "title": "JPEG-derived magazine article package, shared restoration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "issue_id",
    "toc_entry_id",
    "title",
    "source",
    "toc_pin",
    "coordinates",
    "pages",
    "regions",
    "excluded_regions",
    "mapping",
    "raw_ocr",
    "blocks",
    "figures",
    "downloads",
    "corrections",
    "availability",
    "verification",
    "relationships",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/id"
    },
    "issue_id": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/issue_id"
    },
    "toc_entry_id": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/toc_entry_id"
    },
    "title": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/title"
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "const": "jpeg-set"
        }
      },
      "required": [
        "id",
        "sha256",
        "path",
        "bytes",
        "kind"
      ],
      "additionalProperties": false
    },
    "toc_pin": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/toc_pin"
    },
    "coordinates": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/coordinates"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_index": {
            "type": "integer",
            "minimum": 0
          },
          "image": {
            "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/toc_pin"
          },
          "width_px": {
            "type": "integer",
            "minimum": 1
          },
          "height_px": {
            "type": "integer",
            "minimum": 1
          },
          "reading_order": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "source_filename_number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "printed_page": {
            "type": [
              "string",
              "null"
            ]
          },
          "orientation_correction": {
            "description": "Optional clockwise raster correction after PDF rotation. Region coordinates use the corrected image; source geometry stays unchanged.",
            "type": "object",
            "properties": {
              "clockwise_degrees": {
                "type": "integer",
                "enum": [
                  90,
                  180,
                  270
                ]
              },
              "evidence": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "clockwise_degrees",
              "evidence"
            ],
            "additionalProperties": false
          },
          "image_to_upright_normalized": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          }
        },
        "required": [
          "source_index",
          "image",
          "width_px",
          "height_px",
          "reading_order",
          "source_filename_number",
          "printed_page",
          "image_to_upright_normalized"
        ]
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "section-label",
              "title",
              "byline",
              "prose",
              "code",
              "caption",
              "figure",
              "advertisement",
              "unlisted",
              "other"
            ]
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "notes": {
            "type": "string"
          },
          "source_index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "source_index",
          "kind",
          "bbox",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "excluded_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "section-label",
              "title",
              "byline",
              "prose",
              "code",
              "caption",
              "figure",
              "advertisement",
              "unlisted",
              "other"
            ]
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "notes": {
            "type": "string"
          },
          "source_index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "source_index",
          "kind",
          "bbox",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "mapping": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/mapping"
    },
    "raw_ocr": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/raw_ocr"
    },
    "blocks": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/blocks"
    },
    "figures": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/figures"
    },
    "downloads": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/downloads"
    },
    "corrections": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/corrections"
    },
    "availability": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/availability"
    },
    "verification": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/verification"
    },
    "relationships": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/relationships"
    },
    "gaps": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/gaps"
    },
    "content_order": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/content_order"
    },
    "region_assets": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/region_assets"
    },
    "review_records": {
      "$ref": "https://example.invalid/maso/pdf-article.schema.json#/properties/review_records"
    }
  }
}
