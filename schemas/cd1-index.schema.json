{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CD1 index occurrences and grouped native references, version 1",
  "type": "object", "additionalProperties": false,
  "required": ["entries", "references"],
  "properties": {
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^cd1-index:(column|language|panecmds)\\.lst:[0-9a-f]{64}:L[1-9][0-9]*$"},
    "issue": {"type": ["string", "null"], "pattern": "^19[0-9]{2}-(0[1-9]|1[0-2])$"},
    "nullable_string": {"type": ["string", "null"]},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "source", "raw_line", "indent", "kind", "parent_id", "category_path", "label", "title", "display_issue", "reference_raw", "reference"],
      "properties": {
        "schema_version": {"const": 1}, "id": {"$ref": "#/$defs/id"},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "sha256", "encoding", "line", "byte_offset", "byte_length"],
          "properties": {
            "name": {"enum": ["column.lst", "language.lst", "panecmds.lst"]},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "encoding": {"const": "cp949"}, "line": {"type": "integer", "minimum": 1},
            "byte_offset": {"type": "integer", "minimum": 0}, "byte_length": {"type": "integer", "minimum": 1}
          }
        },
        "raw_line": {"type": "string", "minLength": 1},
        "indent": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["category", "reference", "terminator", "unparsed"]},
        "parent_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "category_path": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["entry_id", "label"],
          "properties": {"entry_id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1}}
        }},
        "label": {"$ref": "#/$defs/nullable_string"}, "title": {"$ref": "#/$defs/nullable_string"},
        "display_issue": {"$ref": "#/$defs/issue"},
        "reference_raw": {"$ref": "#/$defs/nullable_string"}, "reference": {"$ref": "#/$defs/nullable_string"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "reference"}}},
         "then": {"properties": {"reference": {"type": "string", "minLength": 1, "not": {"const": "*"}}, "label": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"kind": {"const": "category"}}},
         "then": {"properties": {"reference": {"const": "*"}, "label": {"type": "string", "minLength": 1}}}}
      ]
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "reference", "reference_kind", "issue_candidate", "in_target_period_candidate", "occurrence_ids", "title_variants"],
      "properties": {
        "schema_version": {"const": 1}, "reference": {"type": "string", "minLength": 1},
        "reference_kind": {"enum": ["numeric", "suffixed", "named"]},
        "issue_candidate": {"$ref": "#/$defs/issue"}, "in_target_period_candidate": {"type": ["boolean", "null"]},
        "occurrence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "title_variants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
