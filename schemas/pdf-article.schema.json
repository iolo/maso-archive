{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/maso/pdf-article.schema.json",
  "title": "Scan-derived magazine article package",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^scan-maso-[0-9]{4}-[0-9]{2}-toc-[0-9]{4}$"
    },
    "issue_id": {
      "type": "string"
    },
    "toc_entry_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "sha256",
        "path",
        "bytes"
      ],
      "additionalProperties": false
    },
    "toc_pin": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "coordinates": {
      "const": "upright-normalized-top-left"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pdf_index": {
            "type": "integer",
            "minimum": 0
          },
          "pdf_page": {
            "type": "integer",
            "minimum": 1
          },
          "printed_page": {
            "type": [
              "string",
              "null"
            ]
          },
          "width_pt": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height_pt": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rotation": {
            "enum": [
              0,
              90,
              180,
              270
            ]
          },
          "orientation_correction": {
            "description": "Optional clockwise raster correction after PDF rotation. Region coordinates use the corrected image; source geometry stays unchanged.",
            "type": "object",
            "properties": {
              "clockwise_degrees": {"type": "integer", "enum": [90, 180, 270]},
              "evidence": {"type": "string", "pattern": "\\S"}
            },
            "required": ["clockwise_degrees", "evidence"],
            "additionalProperties": false
          },
          "MediaBox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "CropBox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "pdf_to_upright_normalized": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          }
        },
        "required": [
          "pdf_index",
          "pdf_page",
          "printed_page",
          "width_pt",
          "height_pt",
          "rotation",
          "MediaBox",
          "CropBox",
          "pdf_to_upright_normalized"
        ],
        "additionalProperties": false
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "pdf_index": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "section-label",
              "title",
              "byline",
              "prose",
              "code",
              "caption",
              "figure",
              "advertisement",
              "unlisted",
              "other"
            ]
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "pdf_index",
          "kind",
          "bbox",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "excluded_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "pdf_index": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "section-label",
              "title",
              "byline",
              "prose",
              "code",
              "caption",
              "figure",
              "advertisement",
              "unlisted",
              "other"
            ]
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "pdf_index",
          "kind",
          "bbox",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "mapping": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "mapped",
            "partial",
            "unresolved"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "evidence",
        "uncertainties"
      ],
      "additionalProperties": false
    },
    "raw_ocr": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          },
          "positions": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          },
          "settings": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "region_ids",
          "text",
          "positions",
          "settings"
        ],
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "section-label",
              "title",
              "byline",
              "prose",
              "code",
              "caption"
            ]
          },
          "text": {
            "type": "string"
          },
          "region_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correction_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "region_ids",
          "correction_evidence",
          "uncertainties"
        ],
        "additionalProperties": false
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "region_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asset": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          },
          "caption": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "region_ids",
          "asset",
          "caption"
        ],
        "additionalProperties": false
      }
    },
    "downloads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "availability": {
      "enum": [
        "readable",
        "partial",
        "image-only",
        "failed",
        "unresolved"
      ]
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "sample-reviewed",
            "fully-reviewed"
          ]
        },
        "reviewed_region_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "reviewed_region_ids",
        "evidence",
        "uncertainties"
      ],
      "additionalProperties": false
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "article_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "scan-cd-comparison"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "article_id",
          "kind",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_order": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id"
        ],
        "properties": {
          "type": {
            "enum": [
              "block",
              "figure"
            ]
          },
          "id": {
            "type": "string"
          }
        }
      }
    },
    "region_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region_id",
          "asset"
        ],
        "properties": {
          "region_id": {
            "type": "string"
          },
          "asset": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "review_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "issue_id",
    "toc_entry_id",
    "title",
    "source",
    "toc_pin",
    "coordinates",
    "pages",
    "regions",
    "excluded_regions",
    "mapping",
    "raw_ocr",
    "blocks",
    "figures",
    "downloads",
    "corrections",
    "availability",
    "verification",
    "relationships",
    "gaps"
  ]
}
